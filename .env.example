# Database (PostgreSQL 16 con pgvector)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/lean_crm

# Redis (Colas y pub/sub para mensajería en tiempo real)
REDIS_URL=redis://127.0.0.1:6379

# Meta Cloud API (Canal Oficial WhatsApp)
META_WA_ENABLED=false
META_WA_PHONE_NUMBER_ID=your_meta_phone_number_id
META_WA_ACCESS_TOKEN=your_meta_system_user_token
META_WA_APP_SECRET=your_meta_app_secret
META_WA_VERIFY_TOKEN=your_secure_verify_token

# WAHA NOWEB (Canal Secundario / WhatsApp Web API)
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=your_waha_api_key
WAHA_DEFAULT_SESSION=default
WAHA_DASHBOARD_USER=admin
WAHA_DASHBOARD_PASS=admin_password

# Email Masivo / Listmonk
LISTMONK_URL=http://127.0.0.1:9000
LISTMONK_USER=admin
LISTMONK_PASSWORD=your_listmonk_password

# Transaccional Email (Resend opcional)
RESEND_API_KEY=your_resend_api_key

# AI Providers & Modelos
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Embedding & RAG Config (LightRAG)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LIGHTRAG_TOP_ENTITIES=3
LIGHTRAG_MAX_HOPS=2

# STT (Transcripción de Notas de Voz)
TRANSCRIPTION_PROVIDER=groq
TRANSCRIPTION_MODEL=whisper-large-v3

# Auth.js / NextAuth v5
AUTH_SECRET=generate_with_openssl_rand_base64_32
AUTH_TRUST_HOST=true

# Credenciales de Administrador Inicial (Sembrado)
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=define_tu_password_segura
