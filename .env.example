# Database
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/lean_crm

# Meta Cloud API (Canal Oficial)
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_APP_SECRET=
META_WA_VERIFY_TOKEN=super_secure_verify_token

# WAHA NOWEB (Canal Secundario / Emulación)
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=
WAHA_DEFAULT_SESSION=default

# AI Providers & Modelos
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# Embedding & RAG Config
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LIGHTRAG_TOP_ENTITIES=3
LIGHTRAG_MAX_HOPS=2

# STT (Audio Transcription)
TRANSCRIPTION_PROVIDER=groq # groq | openai
TRANSCRIPTION_MODEL=whisper-large-v3
